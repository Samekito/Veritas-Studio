{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/customer": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/admin": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": ["**/*.d.ts", "**/test-prod.js"],
  "ignoreBinaries": ["tsc"]
}
