{
  "name": "veritas-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veritas Studio monorepo — customer app, admin console, and shared package.",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "concurrently -n backend,customer,admin -c green,blue,magenta \"pnpm dev:backend\" \"pnpm dev:customer\" \"pnpm dev:admin\"",
    "dev:web": "turbo run dev",
    "dev:backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev:customer": "pnpm --filter @veritas/customer dev",
    "dev:admin": "pnpm --filter @veritas/admin dev",
    "build": "turbo run build",
    "build:customer": "turbo run build --filter @veritas/customer",
    "build:admin": "turbo run build --filter @veritas/admin",
    "preview:customer": "pnpm --filter @veritas/customer preview",
    "preview:admin": "pnpm --filter @veritas/admin preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deadcode": "pnpm dlx knip",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,css}\" \"packages/**/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx,css}\" \"packages/**/src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.11.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "express": "^5.2.1",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.2",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
