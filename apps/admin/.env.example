# Base URL of the FastAPI backend. Leave empty to use the Vite dev proxy (/api).
# In production set this to your deployed backend, e.g. https://veritas-api.onrender.com
VITE_API_BASE=

# URL of the customer app (used by the "View" action to open a run's Content Passport).
VITE_CUSTOMER_URL=http://localhost:5173
