Backblaze B2 (REQUIRED)
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET=your_b2_bucket_name
B2_REGION=us-east-005

# GMI Cloud (REQUIRED — powers image/video/audio generation)
GMI_API_KEY=your_gmi_api_key

IMAGE_MODEL=seedream-5.0-lite
IMAGE_FALLBACKS=gemini-2.5-flash-image
VIDEO_MODEL=Kling-Image2Video-V2.1-Master
VIDEO_FALLBACKS=
AUDIO_MODEL=minimax-tts-speech-2.6-turbo
AUDIO_FALLBACKS=

PIPELINE_MODE=chain

# Default clip settings
VIDEO_DURATION=5
ASPECT_RATIO=16:9
VOICE_ID=

# Admin console auth.
# Login is verified against ADMIN_PASSWORD_HASH — a salted scrypt hash, so no
# recoverable password is stored. Generate one (plaintext never leaves your box):
#   python -m app.hashpw
# ADMIN_TOKEN is the opaque bearer secret returned on login and required by admin
# routes — set it to a random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production BOTH must be set (the app refuses to boot otherwise).
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN=
# Dev-only convenience: used only when ADMIN_PASSWORD_HASH is unset (default below).
ADMIN_PASSWORD=

# Deployment: "development" (default) relaxes prod-only startup guards.
# Set ENV=production on real deploys to enforce them.
ENV=development

# Abuse / cost controls (generation spends real money)
MAX_CONCURRENT_JOBS=3
GENERATE_RATE_LIMIT=5           # generations per IP per window
GENERATE_RATE_WINDOW=3600       # window in seconds
DAILY_COST_CAP_USD=25           # rolling 24h spend cap; 0 disables
MAX_UPLOAD_BYTES=209715200      # /api/verify upload cap (200 MiB)
TRUSTED_PROXY_HOPS=1            # reverse-proxy hops for client-IP extraction

# App
DB_PATH=veritas.sqlite
KEY_PREFIX=veritas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
